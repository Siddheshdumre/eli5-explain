# ==========================================================
# ELI5 Universe Builder - environment variables
# This app uses TWO env files. Copy each block into its file:
#   1) backend/.env   (read by the FastAPI backend)
#   2) .env           (project root, read by Vite for the React frontend)
# Format: KEY=value (no quotes, no spaces around =). Never commit real keys.
# ==========================================================


# ---------------- 1) backend/.env ----------------

# [REQUIRED] Groq LLM key - https://console.groq.com/keys  (gsk_...)
GROQ_API_KEY=

# [REQUIRED for login + chat history] Supabase -> Project Settings -> API
# URL: https://<project-ref>.supabase.co
# Key: "anon public" (eyJ...) or "publishable" (sb_publishable_...). NEVER service_role.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# [OPTIONAL] "Agentic Web Search" source - https://app.tavily.com  (tvly-...)
TAVILY_API_KEY=

# [OPTIONAL] Groq model (default: openai/gpt-oss-120b). Available models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# [OPTIONAL, Docker only] Gunicorn worker count (default: 4)
# GUNICORN_WORKERS=2


# ---------------- 2) .env (project root) ----------------

# [REQUIRED for login + chat history] Same values as SUPABASE_URL / SUPABASE_ANON_KEY
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [OPTIONAL] Leave empty for local dev, Docker and Vercel.
# Set only when the backend is on a different domain (e.g. Render):
# VITE_API_URL=https://eli5-backend.onrender.com
VITE_API_URL=
